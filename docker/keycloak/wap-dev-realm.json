{
  "realm": "wap-dev",
  "enabled": true,
  "displayName": "Warehouse App Platform (dev)",
  "registrationAllowed": false,
  "groups": [
    { "name": "tenant-demo-north", "path": "/tenant-demo-north" },
    { "name": "tenant-demo-south", "path": "/tenant-demo-south" }
  ],
  "clients": [
    {
      "clientId": "wap-web",
      "name": "WAP web client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8100/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8100"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "north.admin",
      "email": "north.admin@example.com",
      "firstName": "North",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/tenant-demo-north"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    },
    {
      "username": "south.admin",
      "email": "south.admin@example.com",
      "firstName": "South",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/tenant-demo-south"],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    }
  ]
}
