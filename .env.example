# Local development settings. Copy to .env; never commit .env.

POSTGRES_SUPERUSER_PASSWORD=postgres
WAP_OWNER_PASSWORD=wap_owner_dev
WAP_APP_PASSWORD=wap_app_dev

# Used by the backend when it runs on the host (outside Docker)
WAP_DATABASE_URL=postgresql://wap_app:wap_app_dev@localhost:5433/wap
WAP_MIGRATION_DATABASE_URL=postgresql://wap_owner:wap_owner_dev@localhost:5433/wap

WAP_CLICKHOUSE_HOST=localhost
WAP_CLICKHOUSE_PORT=8123
WAP_CLICKHOUSE_USER=wap
WAP_CLICKHOUSE_PASSWORD=wap_dev
WAP_CLICKHOUSE_DATABASE=wap

# Integration tests (database wap_test is created by docker/postgres/init)
WAP_TEST_DATABASE_URL=postgresql://wap_app:wap_app_dev@localhost:5433/wap_test
WAP_TEST_MIGRATION_DATABASE_URL=postgresql://wap_owner:wap_owner_dev@localhost:5433/wap_test

KEYCLOAK_ADMIN_PASSWORD=admin
